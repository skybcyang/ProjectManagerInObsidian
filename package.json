{
  "name": "obsidian-project-manager",
  "version": "0.1.0",
  "description": "在 Obsidian 中进行项目管理",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs production",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "project-management"
  ],
  "author": "skybcyang",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "builtin-modules": "^5.0.0",
    "esbuild": "^0.20.0",
    "obsidian": "latest",
    "tslib": "^2.6.0",
    "typescript": "^5.3.0"
  }
}
